{
  "name": "truss-harness",
  "version": "0.1.0",
  "private": true,
  "description": "Portable engineering harness for coding agents.",
  "type": "module",
  "bin": {
    "truss": "./bin/truss.mjs"
  },
  "scripts": {
    "truss": "node ./bin/truss.mjs",
    "doctor": "node ./bin/truss.mjs doctor",
    "status": "node ./bin/truss.mjs status",
    "validate-config": "node ./bin/truss.mjs config",
    "graphify": "node ./bin/truss.mjs graphify",
    "verify": "node ./bin/truss.mjs verify",
    "test": "npm run test:unit && npm run test:integration && npm run test:e2e",
    "test:unit": "node --test --test-concurrency=1 test/unit/*.test.mjs",
    "test:integration": "node --test --test-concurrency=1 test/integration/*.test.mjs",
    "test:e2e": "node --test --test-concurrency=1 test/e2e/*.test.mjs",
    "test:coverage": "node --test --test-concurrency=1 --experimental-test-coverage --test-coverage-lines=80 --test-coverage-branches=60 --test-coverage-functions=85 test/unit/*.test.mjs test/integration/*.test.mjs test/e2e/*.test.mjs",
    "check": "node ./scripts/check-syntax.mjs",
    "ci": "npm run check && npm test"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
