{
  "name": "truss-harness",
  "version": "0.2.5",
  "private": true,
  "description": "Portable engineering harness for coding agents.",
  "type": "module",
  "bin": {
    "truss": "./bin/truss.mjs"
  },
  "scripts": {
    "truss": "node ./bin/truss.mjs",
    "doctor": "node ./bin/truss.mjs doctor",
    "status": "node ./bin/truss.mjs status",
    "validate-config": "node ./bin/truss.mjs config",
    "graphify": "node ./bin/truss.mjs graphify",
    "verify": "node ./bin/truss.mjs verify",
    "test": "npm run test:unit && npm run test:integration && npm run test:e2e",
    "test:unit": "node scripts/run-tests.mjs unit",
    "test:integration": "node scripts/run-tests.mjs integration",
    "test:e2e": "node scripts/run-tests.mjs e2e",
    "test:coverage": "node scripts/run-tests.mjs all --experimental-test-coverage --test-coverage-lines=90 --test-coverage-branches=75 --test-coverage-functions=95",
    "check": "node ./scripts/check-syntax.mjs",
    "check:docs": "node ./scripts/check-docs.mjs",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "ci": "npm run check && npm run check:docs && npm run lint && npm test"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "2.5.14"
  }
}
